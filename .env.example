# Copy to .env and adjust. Never commit the real .env file.

# Security — generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Addresses users type in the browser (server name / IP), comma separated.
DJANGO_ALLOWED_HOSTS=portal.example.uz,10.0.0.15
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.uz
# Set to 1 once the portal is served over HTTPS (secure cookies, HSTS).
DJANGO_HTTPS=0

# Shown in the header and on printed reports.
ORGANIZATION_NAME=Agency for Development of Light Industry

# Database (docker-compose uses PostgreSQL).
DB_ENGINE=postgres
DB_NAME=project_office
DB_USER=project_office
DB_PASSWORD=change-me-too
DB_HOST=db
DB_PORT=5432

TIME_ZONE=Asia/Tashkent
ATTACHMENT_MAX_SIZE_MB=25
